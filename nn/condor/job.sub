# GPU batch job on Stoomboot, see https://kb.nikhef.nl/ct/Batch_jobs_GPU.html
# Submit from nn/:
#   condor_submit condor/job.sub                                   # train (main.py)
#   condor_submit condor/job.sub 'args=evaluate.py ../models/<checkpoint>.pt' category=short
# category sets the max runtime: express 10 min, short 4 h, medium 24 h, long 96 h
executable       = condor/run.sh
arguments        = $(args:main.py)
+SingularityImage = "/data/gravwav/nmacdona/containers/vitis-ai-pytorch-gpu-3.5.0.sif"
+JobCategory     = "$(category:medium)"
accounting_group = gravwav

request_gpus     = 1
request_cpus     = 4
request_memory   = 16G

logdir           = /data/gravwav/nmacdona/earlywarningfpgas/output/condor
output           = $(logdir)/$(ClusterId).out
error            = $(logdir)/$(ClusterId).err
log              = $(logdir)/$(ClusterId).log
queue
